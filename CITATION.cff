    given-names: Ruopu
    affiliation: "Southern Illinois University, Carbondale"
  - family-names: Kharazi
    given-names: Pouria
    affiliation: "Southern Illinois University, Carbondale"
keywords:
  - groundwater
  - surrogate modeling
  - physics-informed neural networks
  - MODFLOW
  - conservation diagnostics
